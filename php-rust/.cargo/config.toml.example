# ESEMPIO di config locale NON tracciata (copiare in .cargo/config.toml).
# Il target-dir personale resta fuori dal repo (audit Sol P0.1): su questa
# macchina punta al disco interno perche' il volume esterno non supporta gli
# hardlink della cache incrementale di cargo (cargo stampa "hard linking
# files ... failed" e puo' lasciare binari stale/incoerenti).
# Dal 2026-09-29 (S-182) il default e' la target di SVILUPPO nella sparsebundle APFS
# phpr-target (wp182-harness/phpr-target-bundle.sh mount; verdetto B/A 1,002); la target CANONICA
# ~/Claude/php-rust-output porta i binari pinnati e la usano SOLO scripts/pin-*.sh
# e le build di promozione, sempre con CARGO_TARGET_DIR esplicito.
[build]
target-dir = "/Users/francescotinti/Claude/phpr-target/dev-output"
