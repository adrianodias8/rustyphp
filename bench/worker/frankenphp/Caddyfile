# FrankenPHP worker mode for bench/worker/bench-wrk.sh (the script rewrites
# `num`): 8080 = Symfony worker, 8081 = hello worker. Access logs off.
{
	auto_https off
	frankenphp {
		worker {
			file /work/php-rust/bench/worker/frankenphp/symfony/index.php
			num 4
			env SYMFONY_DIR /scratch/symfony-app
		}
		worker {
			file /work/php-rust/bench/worker/frankenphp/hello/index.php
			num 4
		}
	}
}
:8080 {
	root * /work/php-rust/bench/worker/frankenphp/symfony
	php_server
}
:8081 {
	root * /work/php-rust/bench/worker/frankenphp/hello
	php_server
}
